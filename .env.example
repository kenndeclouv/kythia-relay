# Kythia RelayCore Configuration

# Server Settings
HOST=0.0.0.0
PORT=8080
HTTP_PORT=8081

# Performance Settings
CHANNEL_BUFFER_SIZE=500
MAX_ROOM_SIZE=0
MAX_MESSAGE_SIZE=1048576
CONNECTION_TIMEOUT=60

# Security Settings
AUTH_ENABLED=false
AUTH_SECRET=your-super-secret-key-at-least-32-characters-long-please
RATE_LIMIT_PER_SECOND=100

# Monitoring Settings
METRICS_ENABLED=true

# Database Settings
DATABASE_URL=mysql://kythia:kythia_password@localhost:3306/kythia
MASTER_KEY_FILE=./.master_key

# Logging
RUST_LOG=info
